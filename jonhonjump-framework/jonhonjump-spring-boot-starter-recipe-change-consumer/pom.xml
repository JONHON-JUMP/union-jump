<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.jonhon.jump.boot</groupId>
        <artifactId>jonhonjump-framework</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>jonhonjump-spring-boot-starter-recipe-change-consumer</artifactId>
    <!-- Starter 独立发布版本，修改此处即可生成供 MES 项目引用的新版本 -->
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>工艺变更消息消费者 Spring Boot Starter</description>

    <dependencies>
        <!-- RabbitMQ 消费监听、手动确认和消息转换能力 -->
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit</artifactId>
        </dependency>
        <!-- 调用 JUMP 状态查询与 MES 处理结果回调接口 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- RabbitMQ JSON 消息转换器依赖，确保 MES 仅引入本 Starter 时也可反序列化消息 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 配置属性元数据生成和日志门面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>
</project>
