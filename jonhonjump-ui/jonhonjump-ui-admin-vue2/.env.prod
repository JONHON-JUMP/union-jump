# 生产环境配置
NODE_ENV = 'production'

# 页面标题
VUE_APP_TITLE = JUMP系统

# 芋道管理系统/生产环境
# 与 Nginx 同域部署：API 走 /admin-api/ 反向代理，留空表示当前站点
VUE_APP_BASE_API = ''

# 部署在 Nginx 根路径 http://ip:8081/
PUBLIC_PATH = /
# 路由 base，根路径部署用 /
VUE_APP_APP_NAME = /

# 多租户的开关
VUE_APP_TENANT_ENABLE = true

# 验证码的开关
VUE_APP_CAPTCHA_ENABLE = false

# 文档的开关
VUE_APP_DOC_ENABLE = false

# 百度统计（内网环境留空，避免 hm.js 加载失败）
VUE_APP_BAIDU_CODE =
